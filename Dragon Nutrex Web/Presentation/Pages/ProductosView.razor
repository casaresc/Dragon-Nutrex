@page "/productos"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Presentation.Components.Productos

@inject ProductoService productoService
@inject AuthService authService
@inject NavigationManager navigationManager

<PageTitle>Productos</PageTitle>

<section class="page-header">
    <h1>Gestión de Productos</h1>
    <p>Administra los productos alimenticios y su información nutricional.</p>
</section>

<section class="productos-container">
    <div class="productos-form-panel">
        <ProductoFormComponent ProductoEditando="productoSeleccionado"
                               OnGuardar="HandleGuardarProducto"
                               OnCancelar="HandleCancelarEdicion" />
    </div>

    <div class="productos-table-panel">
        <ProductoTableComponent Productos="productos"
                                OnEditar="HandleEditarProducto"
                                OnDesactivar="HandleDesactivarProducto"
                                OnActivar="HandleActivarProducto" />
    </div>
</section>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="error-box">
        @errorMensaje
    </div>
}

@if (!string.IsNullOrEmpty(exitoMensaje))
{
    <div class="success-box">
        @exitoMensaje
    </div>
}

@code {
    private List<Producto> productos = new();
    private Producto? productoSeleccionado;
    private string? errorMensaje;
    private string? exitoMensaje;

    /// <summary>
    /// Inicializa la vista y valida acceso administrativo.
    /// </summary>
    protected override void OnInitialized()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        if (authService.SesionActual?.EsAdmin != true)
        {
            navigationManager.NavigateTo("/");
            return;
        }

        CargarProductos();
    }

    /// <summary>
    /// Obtiene los productos desde la capa de servicios.
    /// </summary>
    private void CargarProductos()
    {
        productos = productoService.ObtenerProductos();
    }

    /// <summary>
    /// Guarda un producto nuevo o actualiza uno existente.
    /// </summary>
    /// <param name="producto">Producto recibido desde el formulario.</param>
    private Task HandleGuardarProducto(Producto producto)
    {
        try
        {
            if (producto.Id == Guid.Empty)
            {
                productoService.CrearProducto(producto);
            }
            else
            {
                productoService.ActualizarProducto(producto);
            }

            CargarProductos();
            LimpiarSeleccion();
            MostrarExito("Producto guardado exitosamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Selecciona un producto para edición.
    /// </summary>
    /// <param name="producto">Producto seleccionado en la tabla.</param>
    private Task HandleEditarProducto(Producto producto)
    {
        productoSeleccionado = ClonarProducto(producto);
        LimpiarMensajes();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancela la edición actual.
    /// </summary>
    private Task HandleCancelarEdicion()
    {
        LimpiarSeleccion();
        LimpiarMensajes();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Desactiva un producto del sistema.
    /// </summary>
    /// <param name="productoId">Identificador del producto.</param>
    private Task HandleDesactivarProducto(Guid productoId)
    {
        try
        {
            productoService.DesactivarProducto(productoId);
            CargarProductos();

            MostrarExito("Producto desactivado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al desactivar producto: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Activa un producto del sistema.
    /// </summary>
    /// <param name="productoId">Identificador del producto.</param>
    private Task HandleActivarProducto(Guid productoId)
    {
        try
        {
            productoService.ActivarProducto(productoId);
            CargarProductos();

            MostrarExito("Producto activado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al activar producto: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Crea una copia del producto para edición.
    /// </summary>
    /// <param name="producto">Producto origen.</param>
    /// <returns>Producto clonado.</returns>
    private static Producto ClonarProducto(Producto producto)
    {
        return new Producto
        {
            Id = producto.Id,
            Nombre = producto.Nombre,
            Categoria = producto.Categoria,
            Proteina = producto.Proteina,
            Carbohidratos = producto.Carbohidratos,
            Grasas = producto.Grasas,
            PorcionGramos = producto.PorcionGramos,
            Calorias = producto.Calorias,
            Activo = producto.Activo
        };
    }

    /// <summary>
    /// Limpia la selección actual del formulario.
    /// </summary>
    private void LimpiarSeleccion()
    {
        productoSeleccionado = null;
    }

    /// <summary>
    /// Limpia los mensajes de éxito y error.
    /// </summary>
    private void LimpiarMensajes()
    {
        errorMensaje = null;
        exitoMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de éxito.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarExito(string mensaje)
    {
        exitoMensaje = mensaje;
        errorMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de error.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
        exitoMensaje = null;
    }
}