@page "/imc"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Presentation.Components.Nutricion
@inject AuthService authService
@inject UsuarioService usuarioService
@inject NavigationManager navigationManager

<PageTitle>IMC</PageTitle>

<section class="page-header">
    <h1>Cálculo de IMC</h1>
    <p>Consulta el índice de masa corporal a partir del peso y la altura.</p>
</section>

<section class="nutricion-container">
    <div class="nutricion-panel">
        <IMCFormComponent ConsultaInicial="consultaInicial"
                          OnCalcular="HandleCalcularImc"
                          ResultadoImc="resultadoImc"
                          Clasificacion="@clasificacion" />
    </div>
</section>

@code {
    private decimal resultadoImc;
    private string clasificacion = "Sin cálculo";
    private ConsultaImc consultaInicial = new();
    private Usuario? usuarioActual;

    protected override void OnInitialized()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        usuarioActual = usuarioService.ObtenerPorId(authService.SesionActual!.UsuarioId);

        if (usuarioActual is not null)
        {
            consultaInicial = new ConsultaImc
            {
                Peso = usuarioActual.Peso,
                Altura = usuarioActual.Altura
            };
        }
    }

    private Task HandleCalcularImc(ConsultaImc consulta)
    {
        resultadoImc = SaludService.CalcularIMC(consulta.Peso, consulta.Altura);
        clasificacion = ObtenerClasificacionImc(resultadoImc);

        return Task.CompletedTask;
    }

    private static string ObtenerClasificacionImc(decimal imc)
    {
        if (imc <= 0) return "Sin cálculo";
        if (imc < 18.5m) return "Bajo peso";
        if (imc < 25m) return "Peso normal";
        if (imc < 30m) return "Sobrepeso";
        return "Obesidad";
    }

    public class ConsultaImc
    {
        public decimal Peso { get; set; }
        public decimal Altura { get; set; }
    }
}