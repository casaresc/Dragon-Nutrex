@page "/menus"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Presentation.Components.Menus

@inject MenuDiarioService menuDiarioService
@inject MenuDetalleService menuDetalleService
@inject ProductoService productoService
@inject UsuarioService usuarioService
@inject AuthService authService
@inject NavigationManager navigationManager

<PageTitle>Menús</PageTitle>

<section class="page-header">
    <h1>Gestión de Menús</h1>
    <p>Crea, consulta y elimina menús persistidos.</p>
</section>

<section class="menus-container">
    <div class="menus-form-panel">
        <MenuFormComponent MenuEditando="menuActual"
                           Usuarios="usuarios"
                           MostrarSelectorUsuario="EsAdmin"
                           UsuarioFijoId="EsAdmin ? (Guid?)null : UsuarioAutenticadoId"
                           OnGuardar="HandleGuardarMenu"
                           OnCancelar="HandleCancelarMenu"
                           OnCambioMenuBase="HandleCambioMenuBase" />

        <ProductoSelectorComponent Productos="productosActivos"
                                   OnAgregarProducto="HandleAgregarProducto" />

        @if (!string.IsNullOrWhiteSpace(estadoMenu))
        {
            <div class="info-box">
                @estadoMenu
            </div>
        }
    </div>

    <div class="menus-table-panel">
        <MenusTableComponent Menus="menus"
                             Usuarios="usuarios"
                             OnVerDetalle="HandleVerDetalleMenu"
                             OnEliminarMenu="HandleEliminarMenu" />

        <MenuDetalleTableComponent @key="menuActual.Id"
                                   Detalles="detallesTemporales"
                                   Productos="productos"
                                   OnEliminarDetalle="HandleEliminarDetalle" />
    </div>

    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="error-box">
            @errorMensaje
        </div>
    }

    @if (!string.IsNullOrEmpty(exitoMensaje))
    {
        <div class="success-box">
            @exitoMensaje
        </div>
    }
</section>

@code {
    private List<Usuario> usuarios = new();
    private List<Producto> productos = new();
    private List<Producto> productosActivos = new();
    private List<MenuDiario> menus = new();
    private List<MenuDetalle> detallesTemporales = new();

    private string estadoMenu = "Nuevo menú";
    private MenuDiario menuActual = CrearMenuVacio();
    private bool modoEdicion;
    private string? errorMensaje;
    private string? exitoMensaje;

    private bool EsAdmin => authService.SesionActual?.EsAdmin == true;
    private Guid UsuarioAutenticadoId => authService.SesionActual?.UsuarioId ?? Guid.Empty;

    /// <summary>
    /// Carga datos persistidos al iniciar la vista.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        CargarDatos();

        if (!EsAdmin)
        {
            menuActual.UsuarioId = UsuarioAutenticadoId;
            await CargarContextoMenuUsuarioActualAsync();
        }
    }

    /// <summary>
    /// Carga usuarios, productos y menús desde persistencia.
    /// </summary>
    private void CargarDatos()
    {
        usuarios = usuarioService.ObtenerTodos();
        productos = productoService.ObtenerProductos();
        productosActivos = productos.Where(producto => producto.Activo).ToList();
        menus = ObtenerMenusSegunRol();
    }

    /// <summary>
    /// Agrega un producto al menú actual.
    /// </summary>
    /// <param name="detalle">Detalle recibido desde el selector.</param>
    private Task HandleAgregarProducto(MenuDetalle detalle)
    {
        try
        {
            if (modoEdicion && menuActual.Id != Guid.Empty)
            {
                detalle.Id = Guid.NewGuid();
                detalle.MenuId = menuActual.Id;

                menuDetalleService.AgregarProducto(detalle);
                RecargarDetallesMenuActual();

                MostrarExito("Producto agregado y guardado correctamente.");
            }
            else
            {
                detalle.Id = Guid.NewGuid();
                detalle.MenuId = menuActual.Id == Guid.Empty ? Guid.NewGuid() : menuActual.Id;

                detallesTemporales.Add(detalle);
                MostrarExito("Producto agregado al menú temporalmente.");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al agregar producto: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Elimina un detalle del menú actual.
    /// </summary>
    /// <param name="detalleId">Identificador del detalle.</param>
    private Task HandleEliminarDetalle(Guid detalleId)
    {
        try
        {
            var detalle = detallesTemporales.FirstOrDefault(item => item.Id == detalleId);

            if (detalle is null)
            {
                MostrarError("El detalle no existe.");
                return Task.CompletedTask;
            }

            if (modoEdicion && menuActual.Id != Guid.Empty)
            {
                menuDetalleService.EliminarProducto(detalleId);
                RecargarDetallesMenuActual();

                MostrarExito("Detalle eliminado y guardado correctamente.");
            }
            else
            {
                detallesTemporales.Remove(detalle);
                MostrarExito("Detalle eliminado temporalmente.");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al eliminar detalle: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Guarda un menú nuevo o actualiza uno existente con sus detalles.
    /// </summary>
    /// <param name="menu">Menú a persistir.</param>
    private Task HandleGuardarMenu(MenuDiario menu)
    {
        try
        {
            if (!EsAdmin)
            {
                menu.UsuarioId = UsuarioAutenticadoId;
            }

            if (modoEdicion)
            {
                menuDiarioService.ActualizarMenu(menu);

                var detallesExistentes = menuDetalleService.ObtenerPorMenu(menu.Id);

                foreach (var detalleExistente in detallesExistentes)
                {
                    menuDetalleService.EliminarProducto(detalleExistente.Id);
                }

                foreach (var detalle in detallesTemporales)
                {
                    detalle.Id = detalle.Id == Guid.Empty ? Guid.NewGuid() : detalle.Id;
                    detalle.MenuId = menu.Id;
                    menuDetalleService.AgregarProducto(detalle);
                }
            }
            else
            {
                if (menu.Id == Guid.Empty)
                {
                    menu.Id = Guid.NewGuid();
                }

                foreach (var detalle in detallesTemporales)
                {
                    detalle.MenuId = menu.Id;
                }

                menuDiarioService.CrearMenu(menu, detallesTemporales);
            }

            MostrarExito($"Menú guardado correctamente con {detallesTemporales.Count} detalle(s).");
            return ReiniciarVistaAsync(menu.Fecha);
        }
        catch (Exception ex)
        {
            MostrarError($"Error al guardar menú: {ex.Message}");
            return Task.CompletedTask;
        }
    }

    /// <summary>
    /// Carga un menú persistido para visualizar o editar.
    /// </summary>
    /// <param name="menu">Menú seleccionado.</param>
    private Task HandleVerDetalleMenu(MenuDiario menu)
    {
        if (!EsAdmin && menu.UsuarioId != UsuarioAutenticadoId)
        {
            MostrarError("No tienes permiso para visualizar ese menú.");
            return Task.CompletedTask;
        }

        AsignarMenuActual(menu);
        RecargarDetallesMenuActual();

        modoEdicion = true;
        estadoMenu = "Menú existente cargado";
        LimpiarMensajes();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Elimina un menú persistido y sus detalles asociados.
    /// </summary>
    /// <param name="menuId">Identificador del menú.</param>
    private Task HandleEliminarMenu(Guid menuId)
    {
        try
        {
            var menu = menuDiarioService.ObtenerMenus().FirstOrDefault(item => item.Id == menuId);

            if (menu is null)
            {
                MostrarError("El menú no existe.");
                return Task.CompletedTask;
            }

            if (!EsAdmin && menu.UsuarioId != UsuarioAutenticadoId)
            {
                MostrarError("No tienes permiso para eliminar ese menú.");
                return Task.CompletedTask;
            }

            var detalles = menuDetalleService.ObtenerPorMenu(menuId);

            foreach (var detalle in detalles)
            {
                menuDetalleService.EliminarProducto(detalle.Id);
            }

            menuDiarioService.EliminarMenu(menuId);

            if (menuActual.Id == menuId)
            {
                MostrarExito("Menú eliminado correctamente.");
                return ReiniciarVistaAsync();
            }

            menus = ObtenerMenusSegunRol();
            MostrarExito("Menú eliminado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al eliminar menú: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancela la operación actual y limpia el formulario.
    /// </summary>
    private Task HandleCancelarMenu()
    {
        return ReiniciarVistaAsync(menuActual.Fecha);
    }

    /// <summary>
    /// Reinicia el estado de la vista y recarga datos persistidos.
    /// </summary>
    /// <param name="fecha">Fecha objetivo opcional.</param>
    private async Task ReiniciarVistaAsync(DateTime? fecha = null)
    {
        var fechaObjetivo = fecha ?? DateTime.Today;

        menuActual = CrearMenuVacio();
        menuActual.Fecha = fechaObjetivo;

        if (!EsAdmin)
        {
            menuActual.UsuarioId = UsuarioAutenticadoId;
        }

        detallesTemporales = new List<MenuDetalle>();
        modoEdicion = false;
        estadoMenu = string.Empty;
        menus = ObtenerMenusSegunRol();

        if (!EsAdmin)
        {
            await CargarContextoMenuUsuarioActualAsync(fechaObjetivo);
        }
    }

    /// <summary>
    /// Revisa si ya existe un menú para el usuario y la fecha seleccionados.
    /// Si existe, carga el menú y sus detalles.
    /// Si no existe, prepara un menú nuevo.
    /// </summary>
    /// <param name="menuBase">Menú base con usuario y fecha.</param>
    private Task HandleCambioMenuBase(MenuDiario menuBase)
    {
        var usuarioId = EsAdmin ? menuBase.UsuarioId : UsuarioAutenticadoId;

        if (usuarioId == Guid.Empty)
        {
            return Task.CompletedTask;
        }

        var menuExistente = menuDiarioService.ObtenerPorUsuarioYFecha(usuarioId, menuBase.Fecha);

        if (menuExistente is not null)
        {
            AsignarMenuActual(menuExistente);
            RecargarDetallesMenuActual();

            modoEdicion = true;
            estadoMenu = "Menú existente cargado";
        }
        else
        {
            var nombreDebeAutogenerarse =
                string.IsNullOrWhiteSpace(menuBase.Nombre) ||
                menuBase.Nombre.StartsWith("Menú ");

            var nombreActual = nombreDebeAutogenerarse
                ? $"Menú {menuBase.Fecha:dd/MM/yyyy}"
                : menuBase.Nombre;

            menuActual = new MenuDiario
            {
                Id = Guid.Empty,
                UsuarioId = usuarioId,
                Nombre = nombreActual,
                Fecha = menuBase.Fecha
            };

            detallesTemporales = new List<MenuDetalle>();
            modoEdicion = false;
            estadoMenu = "No existe menú para esa fecha. Se creará uno nuevo";
        }

        menus = ObtenerMenusSegunRol();
        errorMensaje = null;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Obtiene la lista de menús según el rol del usuario autenticado.
    /// </summary>
    /// <returns>Lista de menús visibles.</returns>
    private List<MenuDiario> ObtenerMenusSegunRol()
    {
        var todosLosMenus = menuDiarioService.ObtenerMenus();

        if (EsAdmin)
        {
            return todosLosMenus;
        }

        return todosLosMenus
            .Where(menu => menu.UsuarioId == UsuarioAutenticadoId)
            .ToList();
    }

    /// <summary>
    /// Carga el contexto de menú del usuario autenticado.
    /// </summary>
    /// <param name="fecha">Fecha objetivo opcional.</param>
    private async Task CargarContextoMenuUsuarioActualAsync(DateTime? fecha = null)
    {
        if (EsAdmin || UsuarioAutenticadoId == Guid.Empty)
        {
            return;
        }

        menuActual.UsuarioId = UsuarioAutenticadoId;
        menuActual.Fecha = fecha ?? menuActual.Fecha;

        await HandleCambioMenuBase(menuActual);
    }

    /// <summary>
    /// Asigna el menú actual en modo edición.
    /// </summary>
    /// <param name="menu">Menú origen.</param>
    private void AsignarMenuActual(MenuDiario menu)
    {
        menuActual = new MenuDiario
        {
            Id = menu.Id,
            UsuarioId = menu.UsuarioId,
            Nombre = menu.Nombre,
            Fecha = menu.Fecha
        };
    }

    /// <summary>
    /// Recarga los detalles del menú actual desde persistencia.
    /// </summary>
    private void RecargarDetallesMenuActual()
    {
        if (menuActual.Id == Guid.Empty)
        {
            detallesTemporales = new List<MenuDetalle>();
            return;
        }

        detallesTemporales = menuDetalleService.ObtenerPorMenu(menuActual.Id)
            .Select(ClonarDetalle)
            .ToList();
    }

    /// <summary>
    /// Crea una instancia vacía del menú.
    /// </summary>
    /// <returns>Instancia vacía de menú.</returns>
    private static MenuDiario CrearMenuVacio()
    {
        return new MenuDiario
        {
            Id = Guid.Empty,
            UsuarioId = Guid.Empty,
            Nombre = string.Empty,
            Fecha = DateTime.Today
        };
    }

    /// <summary>
    /// Crea una copia de un detalle de menú.
    /// </summary>
    /// <param name="detalle">Detalle origen.</param>
    /// <returns>Detalle clonado.</returns>
    private static MenuDetalle ClonarDetalle(MenuDetalle detalle)
    {
        return new MenuDetalle
        {
            Id = detalle.Id,
            MenuId = detalle.MenuId,
            ProductoId = detalle.ProductoId,
            Porcion = detalle.Porcion
        };
    }

    /// <summary>
    /// Limpia los mensajes de éxito y error.
    /// </summary>
    private void LimpiarMensajes()
    {
        errorMensaje = null;
        exitoMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de éxito.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarExito(string mensaje)
    {
        exitoMensaje = mensaje;
        errorMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de error.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
        exitoMensaje = null;
    }
}