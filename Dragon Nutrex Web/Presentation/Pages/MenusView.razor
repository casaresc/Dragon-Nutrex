@page "/menus"

@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Presentation.Components.Menus

@inject MenuDiarioService menuDiarioService
@inject MenuDetalleService menuDetalleService
@inject ProductoService productoService
@inject UsuarioService usuarioService

<PageTitle>Menús</PageTitle>

<section class="page-header">
    <h1>Gestión de Menús</h1>
    <p>Crea, consulta y elimina menús persistidos.</p>
</section>

<section class="menus-container">
    <div class="menus-form-panel">
        <MenuFormComponent MenuEditando="menuActual"
                           Usuarios="usuarios"
                           OnGuardar="HandleGuardarMenu"
                           OnCancelar="HandleCancelarMenu"
                           OnCambioMenuBase="HandleCambioMenuBase" />

        <ProductoSelectorComponent Productos="productos"
                                   OnAgregarProducto="HandleAgregarProducto" />
        @if (!string.IsNullOrWhiteSpace(estadoMenu))
        {
            <div class="info-box">
                @estadoMenu
            </div>
        }
        <MenuDetalleTableComponent @key="menuActual.Id"
                                   Detalles="detallesTemporales"
                                   Productos="productos"
                                   OnEliminarDetalle="HandleEliminarDetalle" />
    </div>

    <div class="menus-table-panel">
        <MenusTableComponent Menus="menus"
                             Usuarios="usuarios"
                             OnVerDetalle="HandleVerDetalleMenu"
                             OnEliminarMenu="HandleEliminarMenu" />
    </div>
    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="error-box">
            @errorMensaje
        </div>
    }
    @if (!string.IsNullOrEmpty(exitoMensaje))
    {
        <div class="success-box">
            @exitoMensaje
        </div>
    }
</section>

@code {
    private List<Usuario> usuarios = new();
    private List<Producto> productos = new();
    private List<MenuDiario> menus = new();
    private List<MenuDetalle> detallesTemporales = new();
    private string estadoMenu = "Nuevo menú";
    private MenuDiario menuActual = CrearMenuVacio();
    private bool modoEdicion;
    private string? errorMensaje;
    private string? exitoMensaje;
    /// <summary>
    /// Carga datos persistidos al iniciar la vista.
    /// </summary>
    protected override void OnInitialized()
    {
        CargarDatos();
    }

    /// <summary>
    /// Carga usuarios, productos y menús desde persistencia.
    /// </summary>
    private void CargarDatos()
    {
        usuarios = usuarioService.ObtenerTodos();
        productos = productoService.ObtenerProductos();
        menus = menuDiarioService.ObtenerMenus();
    }

    /// <summary>
    /// Agrega un detalle temporal al menú actual.
    /// </summary>
    /// <param name="detalle">Detalle recibido desde el selector.</param>
    private Task HandleAgregarProducto(MenuDetalle detalle)
    {
        try
        {
            detalle.Id = Guid.NewGuid();
            detalle.MenuId = menuActual.Id == Guid.Empty ? Guid.NewGuid() : menuActual.Id;

            detallesTemporales.Add(detalle);
            exitoMensaje = "Producto agregado al menú temporalmente.";
            errorMensaje = null;
            return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al agregar producto: {ex.Message}";
            exitoMensaje = null;
            return Task.CompletedTask;
        }

    }

    /// <summary>
    /// Elimina un detalle temporal del menú actual.
    /// </summary>
    /// <param name="detalleId">Identificador del detalle.</param>
    private Task HandleEliminarDetalle(Guid detalleId)
    {
        var detalle = detallesTemporales.FirstOrDefault(d => d.Id == detalleId);

        if (detalle is not null)
        {
            detallesTemporales.Remove(detalle);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Guarda un menú nuevo con sus detalles.
    /// </summary>
    /// <param name="menu">Menú a persistir.</param>
    private Task HandleGuardarMenu(MenuDiario menu)
    {
        if (modoEdicion)
        {
            menuDiarioService.ActualizarMenu(menu);

            var detallesExistentes = menuDetalleService.ObtenerPorMenu(menu.Id);

            foreach (var detalleExistente in detallesExistentes)
            {
                menuDetalleService.EliminarProducto(detalleExistente.Id);
            }

            foreach (var detalle in detallesTemporales)
            {
                detalle.Id = detalle.Id == Guid.Empty ? Guid.NewGuid() : detalle.Id;
                detalle.MenuId = menu.Id;
                menuDetalleService.AgregarProducto(detalle);
            }
        }
        else
        {
            if (menu.Id == Guid.Empty)
            {
                menu.Id = Guid.NewGuid();
            }

            foreach (var detalle in detallesTemporales)
            {
                detalle.MenuId = menu.Id;
            }

            menuDiarioService.CrearMenu(menu, detallesTemporales);
        }

        ReiniciarVista();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Carga un menú persistido para visualizar o editar.
    /// </summary>
    /// <param name="menu">Menú seleccionado.</param>
    private Task HandleVerDetalleMenu(MenuDiario menu)
    {
        menuActual = new MenuDiario
        {
            Id = menu.Id,
            UsuarioId = menu.UsuarioId,
            Nombre = menu.Nombre,
            Fecha = menu.Fecha
        };

        detallesTemporales = menuDetalleService.ObtenerPorMenu(menu.Id)
            .Select(d => new MenuDetalle
            {
                Id = d.Id,
                MenuId = d.MenuId,
                ProductoId = d.ProductoId,
                Porcion = d.Porcion
            })
            .ToList();

        modoEdicion = true;

        return Task.CompletedTask;
    }

    /// <summary>
    /// Elimina un menú persistido y sus detalles asociados.
    /// </summary>
    /// <param name="menuId">Identificador del menú.</param>
    private Task HandleEliminarMenu(Guid menuId)
    {
        var detalles = menuDetalleService.ObtenerPorMenu(menuId);

        foreach (var detalle in detalles)
        {
            menuDetalleService.EliminarProducto(detalle.Id);
        }

        menuDiarioService.EliminarMenu(menuId);

        if (menuActual.Id == menuId)
        {
            ReiniciarVista();
        }
        else
        {
            menus = menuDiarioService.ObtenerMenus();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancela la operación actual y limpia el formulario.
    /// </summary>
    private Task HandleCancelarMenu()
    {
        ReiniciarVista();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Reinicia el estado de la vista y recarga datos persistidos.
    /// </summary>
    private void ReiniciarVista()
    {
        menuActual = CrearMenuVacio();
        detallesTemporales = new List<MenuDetalle>();
        modoEdicion = false;
        menus = menuDiarioService.ObtenerMenus();
    }

    /// <summary>
    /// Crea una instancia vacía del menú.
    /// </summary>
    private static MenuDiario CrearMenuVacio() =>
        new()
        {
            Id = Guid.Empty,
            UsuarioId = Guid.Empty,
            Nombre = string.Empty,
            Fecha = DateTime.Today
        };

    /// <summary>
    /// Revisa si ya existe un menú para el usuario y la fecha seleccionados.
    /// Si existe, carga el menú y sus detalles.
    /// Si no existe, prepara un menú nuevo.
    /// </summary>
    /// <param name="menuBase">Menú base con usuario y fecha.</param>
    private Task HandleCambioMenuBase(MenuDiario menuBase)
    {
        if (menuBase.UsuarioId == Guid.Empty)
        {
            detallesTemporales = new List<MenuDetalle>();
            menuActual = new MenuDiario
            {
                Id = Guid.Empty,
                UsuarioId = Guid.Empty,
                Nombre = string.Empty,
                Fecha = menuBase.Fecha
            };
            modoEdicion = false;
            estadoMenu = "Seleccione un usuario";
            StateHasChanged();
            return Task.CompletedTask;
        }

        detallesTemporales = new List<MenuDetalle>();
        modoEdicion = false;

        var menuExistente = menuDiarioService.ObtenerPorUsuarioYFecha(
            menuBase.UsuarioId,
            menuBase.Fecha);

        if (menuExistente is not null)
        {
            menuActual = new MenuDiario
            {
                Id = menuExistente.Id,
                UsuarioId = menuExistente.UsuarioId,
                Nombre = menuExistente.Nombre,
                Fecha = menuExistente.Fecha
            };

            detallesTemporales = menuDetalleService.ObtenerPorMenu(menuExistente.Id)
                .Select(detalle => new MenuDetalle
                {
                    Id = detalle.Id,
                    MenuId = detalle.MenuId,
                    ProductoId = detalle.ProductoId,
                    Porcion = detalle.Porcion
                })
                .ToList();

            modoEdicion = true;
            estadoMenu = "Menú existente cargado";
        }
        else
        {
            menuActual = new MenuDiario
            {
                Id = Guid.Empty,
                UsuarioId = menuBase.UsuarioId,
                Nombre = string.IsNullOrWhiteSpace(menuBase.Nombre)
                    ? $"Menú {menuBase.Fecha:dd/MM/yyyy}"
                    : menuBase.Nombre,
                Fecha = menuBase.Fecha
            };

            detallesTemporales = new List<MenuDetalle>();
            modoEdicion = false;
            estadoMenu = "No existe menú para esa fecha. Se creará uno nuevo";
        }

        StateHasChanged();
        return Task.CompletedTask;
    }
}