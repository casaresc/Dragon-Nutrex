@page "/login"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Services

@inject AuthService authService
@inject NavigationManager navigationManager

<PageTitle>Login</PageTitle>

<section class="login-page">
    <div class="login-card">
        <div class="login-header">
            <h1>Iniciar sesión</h1>
            <p>Accede a Dragon Nutrex Web</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMensaje))
        {
            <div class="error-box">
                @errorMensaje
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-group">
                    <label for="txtCorreo">Correo</label>
                    <InputText id="txtCorreo" class="form-control" @bind-Value="loginModel.Correo" />
                </div>

                <div class="form-group">
                    <label for="txtContrasena">Contraseña</label>
                    <InputText id="txtContrasena" type="password" class="form-control" @bind-Value="loginModel.Contrasena" />
                </div>
            </div>

            <div class="button-row">
                <button type="submit" class="btn btn-primary login-button">
                    Entrar
                </button>
            </div>
        </EditForm>
    </div>
</section>

@code {
    private readonly LoginModel loginModel = new();
    private string? errorMensaje;

    /// <summary>
    /// Redirige automáticamente si ya existe una sesión activa.
    /// </summary>
    protected override void OnInitialized()
    {
        if (authService.EstaAutenticado())
        {
            RedirigirSegunRol();
        }
    }

    /// <summary>
    /// Intenta iniciar sesión con las credenciales ingresadas.
    /// </summary>
    private void HandleLogin()
    {
        var autenticado = authService.IniciarSesion(loginModel.Correo, loginModel.Contrasena);

        if (!autenticado)
        {
            MostrarError("Correo o contraseña incorrectos.");
            return;
        }

        LimpiarError();
        RedirigirSegunRol();
    }

    /// <summary>
    /// Redirige al usuario según su rol actual.
    /// </summary>
    private void RedirigirSegunRol()
    {
        if (authService.SesionActual?.EsAdmin == true)
        {
            navigationManager.NavigateTo("/usuarios");
            return;
        }

        navigationManager.NavigateTo("/menus");
    }

    /// <summary>
    /// Muestra un mensaje de error en la vista.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
    }

    /// <summary>
    /// Limpia el mensaje de error actual.
    /// </summary>
    private void LimpiarError()
    {
        errorMensaje = null;
    }

    /// <summary>
    /// Modelo de apoyo para el formulario de inicio de sesión.
    /// </summary>
    public class LoginModel
    {
        /// <summary>
        /// Correo del usuario.
        /// </summary>
        public string Correo { get; set; } = string.Empty;

        /// <summary>
        /// Contraseña del usuario.
        /// </summary>
        public string Contrasena { get; set; } = string.Empty;
    }
}