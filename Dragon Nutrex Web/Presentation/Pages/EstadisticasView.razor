@page "/estadisticas"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Controllers
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Presentation.Components.Estadisticas

@inject UsuarioService usuarioService
@inject ConsumoController consumoController
@inject AuthService authService
@inject NavigationManager navigationManager
@inject ReportExportService reportExportService
@inject IJSRuntime jsRuntime

<PageTitle>Estadísticas</PageTitle>

<section class="page-header">
    <h1>Estadísticas Nutricionales</h1>
    <p>Consulta el consumo diario frente a la meta y el resumen por rango de fechas.</p>
</section>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="error-box">
        @errorMensaje
    </div>
}

@if (!string.IsNullOrEmpty(exitoMensaje))
{
    <div class="success-box">
        @exitoMensaje
    </div>
}

<section class="estadisticas-container">
    <div class="estadisticas-panel">
        <ConsumoMetaComponent Usuarios="usuarios"
                              MostrarSelectorUsuario="EsAdmin"
                              UsuarioFijoId="EsAdmin ? (Guid?)null : UsuarioAutenticadoId"
                              OnConsultar="HandleConsultarConsumoMeta"
                              ResumenDiario="resumenDiario" />

        <div class="button-row">
            <button type="button" class="btn btn-secondary" @onclick="ExportarConsumoMetaCsv">
                Exportar CSV
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarConsumoMetaTxt">
                Exportar TXT
            </button>
        </div>
    </div>

    <div class="estadisticas-panel">
        <EstadisticasRangoComponent Usuarios="usuarios"
                                    MostrarSelectorUsuario="EsAdmin"
                                    UsuarioFijoId="EsAdmin ? (Guid?)null : UsuarioAutenticadoId"
                                    OnConsultar="HandleConsultarRango"
                                    ResumenRango="resumenRango" />

        <div class="button-row">
            <button type="button" class="btn btn-secondary" @onclick="ExportarResumenRangoCsv">
                Exportar CSV
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarResumenRangoTxt">
                Exportar TXT
            </button>
        </div>
    </div>
</section>

@code {
    private List<Usuario> usuarios = new();
    private ResumenDiario resumenDiario = new();
    private ResumenRango resumenRango = new();
    private string? errorMensaje;
    private string? exitoMensaje;

    private bool EsAdmin => authService.SesionActual?.EsAdmin == true;
    private Guid UsuarioAutenticadoId => authService.SesionActual?.UsuarioId ?? Guid.Empty;

    /// <summary>
    /// Carga la lista de usuarios disponibles para las consultas estadísticas.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        usuarios = usuarioService.ObtenerTodos();

        if (!EsAdmin && UsuarioAutenticadoId != Guid.Empty)
        {
            await CargarConsultasUsuarioActualAsync();
        }
    }

    /// <summary>
    /// Consulta el resumen diario de consumo frente a la meta.
    /// </summary>
    /// <param name="parametros">Parámetros de consulta enviados por el componente.</param>
    private Task HandleConsultarConsumoMeta(ConsultaConsumoMeta parametros)
    {
        var usuarioId = EsAdmin ? parametros.UsuarioId : UsuarioAutenticadoId;

        if (usuarioId == Guid.Empty)
        {
            return Task.CompletedTask;
        }

        resumenDiario = consumoController.ObtenerResumenParaUsuarioYFecha(
            usuarioId,
            parametros.Fecha);

        MostrarExito("Consulta de consumo vs meta realizada correctamente.");
        return Task.CompletedTask;
    }

    /// <summary>
    /// Consulta estadísticas por rango de fechas para un usuario.
    /// </summary>
    /// <param name="parametros">Parámetros de consulta enviados por el componente.</param>
    private Task HandleConsultarRango(ConsultaRango parametros)
    {
        var usuarioId = EsAdmin ? parametros.UsuarioId : UsuarioAutenticadoId;

        if (usuarioId == Guid.Empty)
        {
            return Task.CompletedTask;
        }

        resumenRango = consumoController.ObtenerEstadisticasRangoPorUsuario(
            usuarioId,
            parametros.FechaInicio,
            parametros.FechaFin);

        MostrarExito("Consulta de estadísticas por rango realizada correctamente.");
        return Task.CompletedTask;
    }

    /// <summary>
    /// Carga automáticamente las consultas del usuario autenticado.
    /// </summary>
    private async Task CargarConsultasUsuarioActualAsync()
    {
        var consultaConsumo = new ConsultaConsumoMeta
        {
            UsuarioId = UsuarioAutenticadoId,
            Fecha = DateTime.Today
        };

        var consultaRango = new ConsultaRango
        {
            UsuarioId = UsuarioAutenticadoId,
            FechaInicio = DateTime.Today.AddDays(-7),
            FechaFin = DateTime.Today
        };

        await HandleConsultarConsumoMeta(consultaConsumo);
        await HandleConsultarRango(consultaRango);
    }

    /// <summary>
    /// Exporta el reporte de consumo vs meta en formato CSV.
    /// </summary>
    private async Task ExportarConsumoMetaCsv()
    {
        if (!resumenDiario.TieneRegistros)
        {
            MostrarError("No hay datos de consumo vs meta para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarConsumoMetaCsv(resumenDiario);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "consumo_vs_meta.csv",
            contenido,
            "text/csv");

        MostrarExito("Reporte CSV de consumo vs meta exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de consumo vs meta en formato TXT.
    /// </summary>
    private async Task ExportarConsumoMetaTxt()
    {
        if (!resumenDiario.TieneRegistros)
        {
            MostrarError("No hay datos de consumo vs meta para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarConsumoMetaTxt(resumenDiario);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "consumo_vs_meta.txt",
            contenido,
            "text/plain");

        MostrarExito("Reporte TXT de consumo vs meta exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de estadísticas por rango en formato CSV.
    /// </summary>
    private async Task ExportarResumenRangoCsv()
    {
        if (resumenRango.DiasConRegistros == 0)
        {
            MostrarError("No hay datos de estadísticas por rango para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarResumenRangoCsv(resumenRango);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "estadisticas_rango.csv",
            contenido,
            "text/csv");

        MostrarExito("Reporte CSV de estadísticas por rango exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de estadísticas por rango en formato TXT.
    /// </summary>
    private async Task ExportarResumenRangoTxt()
    {
        if (resumenRango.DiasConRegistros == 0)
        {
            MostrarError("No hay datos de estadísticas por rango para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarResumenRangoTxt(resumenRango);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "estadisticas_rango.txt",
            contenido,
            "text/plain");

        MostrarExito("Reporte TXT de estadísticas por rango exportado correctamente.");
    }

    /// <summary>
    /// Muestra un mensaje de éxito.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarExito(string mensaje)
    {
        exitoMensaje = mensaje;
        errorMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de error.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
        exitoMensaje = null;
    }

    /// <summary>
    /// Modelo de apoyo para consultar consumo frente a meta.
    /// </summary>
    public class ConsultaConsumoMeta
    {
        /// <summary>
        /// Identificador del usuario.
        /// </summary>
        public Guid UsuarioId { get; set; }

        /// <summary>
        /// Fecha de consulta.
        /// </summary>
        public DateTime Fecha { get; set; } = DateTime.Today;
    }

    /// <summary>
    /// Modelo de apoyo para consultar estadísticas por rango.
    /// </summary>
    public class ConsultaRango
    {
        /// <summary>
        /// Identificador del usuario.
        /// </summary>
        public Guid UsuarioId { get; set; }

        /// <summary>
        /// Fecha inicial del rango.
        /// </summary>
        public DateTime FechaInicio { get; set; } = DateTime.Today.AddDays(-7);

        /// <summary>
        /// Fecha final del rango.
        /// </summary>
        public DateTime FechaFin { get; set; } = DateTime.Today;
    }
}