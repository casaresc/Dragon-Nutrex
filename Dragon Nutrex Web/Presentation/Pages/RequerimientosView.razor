@page "/requerimientos"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Core.Enums
@using Dragon_Nutrex_Web.Presentation.Components.Nutricion
@inject AuthService authService
@inject UsuarioService usuarioService
@inject NutricionService nutricionService
@inject NavigationManager navigationManager

<PageTitle>Requerimientos Nutricionales</PageTitle>

<section class="page-header">
    <h1>Plan Nutricional</h1>
    <p>Calcula calorías objetivo y distribución de macronutrientes.</p>
</section>

<section class="nutricion-container">
    <div class="nutricion-panel">
        <RequerimientosFormComponent ConsultaInicial="consultaInicial"
                                     OnCalcular="HandleCalcularRequerimientos"
                                     Resultado="resultado" />
    </div>
</section>

@code {
    private RequerimientoNutricional? resultado;
    private ConsultaRequerimientos consultaInicial = new();
    private Usuario? usuarioActual;

    protected override void OnInitialized()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        usuarioActual = usuarioService.ObtenerPorId(authService.SesionActual!.UsuarioId);

        if (usuarioActual is not null)
        {
            consultaInicial = new ConsultaRequerimientos
            {
                Peso = usuarioActual.Peso,
                Altura = usuarioActual.Altura,
                Edad = usuarioActual.Edad,
                NivelActividad = usuarioActual.NivelActividad,
                Objetivo = usuarioActual.Objetivo,
                TipoDieta = usuarioActual.TipoDieta
            };
        }
        else
        {
            consultaInicial = new ConsultaRequerimientos
            {
                NivelActividad = NivelActividad.Sedentario,
                Objetivo = ObjetivoNutricional.MantenerPeso,
                TipoDieta = TipoDieta.Balanceada
            };
        }
    }

    private Task HandleCalcularRequerimientos(ConsultaRequerimientos consulta)
    {
        resultado = nutricionService.CalcularRequerimiento(
            consulta.Peso,
            consulta.Altura,
            consulta.Edad,
            consulta.NivelActividad,
            consulta.Objetivo,
            consulta.TipoDieta);

        return Task.CompletedTask;
    }

    public class ConsultaRequerimientos
    {
        public decimal Peso { get; set; }
        public decimal Altura { get; set; }
        public int Edad { get; set; }
        public NivelActividad NivelActividad { get; set; }
        public ObjetivoNutricional Objetivo { get; set; }
        public TipoDieta TipoDieta { get; set; }
    }
}