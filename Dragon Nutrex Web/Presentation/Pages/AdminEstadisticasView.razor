@page "/admin-estadisticas"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services

@inject AdminEstadisticasService adminEstadisticasService
@inject AuthService authService
@inject NavigationManager navigationManager
@inject ReportExportService reportExportService
@inject IJSRuntime jsRuntime

<PageTitle>Estadísticas Administrativas</PageTitle>

<section class="page-header">
    <h1>Estadísticas Administrativas</h1>
    <p>Consulta indicadores globales del sistema para administración.</p>
</section>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="error-box">
        @errorMensaje
    </div>
}

@if (!string.IsNullOrEmpty(exitoMensaje))
{
    <div class="success-box">
        @exitoMensaje
    </div>
}

<section class="estadisticas-admin-grid">
    <div class="card-panel">
        <div class="card-header">
            <h2>Producto más consumido</h2>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label for="txtFechaInicioProducto">Fecha inicio</label>
                <InputDate id="txtFechaInicioProducto" class="form-control" @bind-Value="fechaInicioProducto" />
            </div>

            <div class="form-group">
                <label for="txtFechaFinProducto">Fecha fin</label>
                <InputDate id="txtFechaFinProducto" class="form-control" @bind-Value="fechaFinProducto" />
            </div>
        </div>

        <div class="button-row">
            <button type="button" class="btn btn-primary" @onclick="HandleConsultarProductoMasConsumido">
                Consultar
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarProductoMasConsumidoCsv">
                Exportar CSV
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarProductoMasConsumidoTxt">
                Exportar TXT
            </button>
        </div>

        <hr />

        @if (productoMasConsumido is null)
        {
            <p>No hay resultado disponible.</p>
        }
        else
        {
            <div class="stats-grid">
                <div class="stat-box">
                    <h3>Producto</h3>
                    <p>@productoMasConsumido.NombreProducto</p>
                </div>

                <div class="stat-box">
                    <h3>Total porciones</h3>
                    <p>@productoMasConsumido.TotalPorciones</p>
                </div>

                <div class="stat-box">
                    <h3>Registros</h3>
                    <p>@productoMasConsumido.TotalRegistros</p>
                </div>
            </div>
        }
    </div>

    <div class="card-panel">
        <div class="card-header">
            <h2>Porcentaje de tipos de dieta</h2>
        </div>

        <div class="button-row">
            <button type="button" class="btn btn-primary" @onclick="HandleConsultarTiposDieta">
                Consultar
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarDietasCsv">
                Exportar CSV
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarDietasTxt">
                Exportar TXT
            </button>
        </div>

        <hr />

        @if (!porcentajesDieta.Any())
        {
            <p>No hay datos disponibles.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Tipo de dieta</th>
                            <th>Cantidad usuarios</th>
                            <th>Porcentaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in porcentajesDieta)
                        {
                            <tr>
                                <td>@item.TipoDieta</td>
                                <td>@item.CantidadUsuarios</td>
                                <td>@item.Porcentaje %</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card-panel">
        <div class="card-header">
            <h2>Usuarios con más menús ingresados</h2>
        </div>

        <div class="button-row">
            <button type="button" class="btn btn-primary" @onclick="HandleConsultarUsuariosConMasMenus">
                Consultar
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarUsuariosMenusCsv">
                Exportar CSV
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportarUsuariosMenusTxt">
                Exportar TXT
            </button>
        </div>

        <hr />

        @if (!usuariosConMasMenus.Any())
        {
            <p>No hay datos disponibles.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Cantidad de menús</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in usuariosConMasMenus)
                        {
                            <tr>
                                <td>@item.NombreUsuario</td>
                                <td>@item.CantidadMenus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@code {
    private DateTime fechaInicioProducto = DateTime.Today.AddDays(-7);
    private DateTime fechaFinProducto = DateTime.Today;

    private ProductoMasConsumidoResultado? productoMasConsumido;
    private List<PorcentajeTipoDietaResultado> porcentajesDieta = new();
    private List<UsuarioMenusResultado> usuariosConMasMenus = new();

    private string? errorMensaje;
    private string? exitoMensaje;

    /// <summary>
    /// Inicializa la vista y valida acceso administrativo.
    /// </summary>
    protected override void OnInitialized()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        if (authService.SesionActual?.EsAdmin != true)
        {
            navigationManager.NavigateTo("/");
            return;
        }

        porcentajesDieta = adminEstadisticasService.ObtenerPorcentajeTiposDieta();
        usuariosConMasMenus = adminEstadisticasService.ObtenerUsuariosConMasMenus();
    }

    /// <summary>
    /// Consulta el producto más consumido dentro de un rango de fechas.
    /// </summary>
    private Task HandleConsultarProductoMasConsumido()
    {
        try
        {
            if (fechaInicioProducto.Date > fechaFinProducto.Date)
            {
                MostrarError("La fecha inicio no puede ser mayor que la fecha fin.");
                return Task.CompletedTask;
            }

            productoMasConsumido = adminEstadisticasService.ObtenerProductoMasConsumido(
                fechaInicioProducto,
                fechaFinProducto);

            MostrarExito("Consulta realizada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al consultar producto más consumido: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Consulta el porcentaje de usuarios por tipo de dieta.
    /// </summary>
    private Task HandleConsultarTiposDieta()
    {
        try
        {
            porcentajesDieta = adminEstadisticasService.ObtenerPorcentajeTiposDieta();
            MostrarExito("Consulta realizada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al consultar porcentaje de dietas: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Consulta los usuarios con más menús ingresados.
    /// </summary>
    private Task HandleConsultarUsuariosConMasMenus()
    {
        try
        {
            usuariosConMasMenus = adminEstadisticasService.ObtenerUsuariosConMasMenus();
            MostrarExito("Consulta realizada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al consultar usuarios con más menús: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Exporta el reporte de producto más consumido en formato CSV.
    /// </summary>
    private async Task ExportarProductoMasConsumidoCsv()
    {
        if (productoMasConsumido is null)
        {
            MostrarError("No hay datos de producto más consumido para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarProductoMasConsumidoCsv(productoMasConsumido);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "producto_mas_consumido.csv",
            contenido,
            "text/csv");

        MostrarExito("Reporte CSV de producto más consumido exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de producto más consumido en formato TXT.
    /// </summary>
    private async Task ExportarProductoMasConsumidoTxt()
    {
        if (productoMasConsumido is null)
        {
            MostrarError("No hay datos de producto más consumido para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarProductoMasConsumidoTxt(productoMasConsumido);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "producto_mas_consumido.txt",
            contenido,
            "text/plain");

        MostrarExito("Reporte TXT de producto más consumido exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de porcentaje de dietas en formato CSV.
    /// </summary>
    private async Task ExportarDietasCsv()
    {
        if (!porcentajesDieta.Any())
        {
            MostrarError("No hay datos de porcentaje de dietas para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarPorcentajeDietasCsv(porcentajesDieta);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "porcentaje_tipos_dieta.csv",
            contenido,
            "text/csv");

        MostrarExito("Reporte CSV de porcentaje de dietas exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de porcentaje de dietas en formato TXT.
    /// </summary>
    private async Task ExportarDietasTxt()
    {
        if (!porcentajesDieta.Any())
        {
            MostrarError("No hay datos de porcentaje de dietas para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarPorcentajeDietasTxt(porcentajesDieta);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "porcentaje_tipos_dieta.txt",
            contenido,
            "text/plain");

        MostrarExito("Reporte TXT de porcentaje de dietas exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de usuarios con más menús en formato CSV.
    /// </summary>
    private async Task ExportarUsuariosMenusCsv()
    {
        if (!usuariosConMasMenus.Any())
        {
            MostrarError("No hay datos de usuarios con más menús para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarUsuariosConMasMenusCsv(usuariosConMasMenus);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "usuarios_con_mas_menus.csv",
            contenido,
            "text/csv");

        MostrarExito("Reporte CSV de usuarios con más menús exportado correctamente.");
    }

    /// <summary>
    /// Exporta el reporte de usuarios con más menús en formato TXT.
    /// </summary>
    private async Task ExportarUsuariosMenusTxt()
    {
        if (!usuariosConMasMenus.Any())
        {
            MostrarError("No hay datos de usuarios con más menús para exportar.");
            return;
        }

        var contenido = reportExportService.ExportarUsuariosConMasMenusTxt(usuariosConMasMenus);

        await jsRuntime.InvokeVoidAsync(
            "downloadFileFromText",
            "usuarios_con_mas_menus.txt",
            contenido,
            "text/plain");

        MostrarExito("Reporte TXT de usuarios con más menús exportado correctamente.");
    }

    /// <summary>
    /// Muestra un mensaje de éxito.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarExito(string mensaje)
    {
        exitoMensaje = mensaje;
        errorMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de error.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
        exitoMensaje = null;
    }
}