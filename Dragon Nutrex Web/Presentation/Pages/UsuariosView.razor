@page "/usuarios"
@rendermode InteractiveServer
@using Dragon_Nutrex_Web.Core.Models
@using Dragon_Nutrex_Web.Core.Services
@using Dragon_Nutrex_Web.Presentation.Components.Usuarios

@inject UsuarioService usuarioService
@inject AuthService authService
@inject NavigationManager navigationManager

<PageTitle>Usuarios</PageTitle>

<section class="page-header">
    <h1>Gestión de Usuarios</h1>
    <p>Administra la información personal y nutricional de los usuarios.</p>
</section>

<section class="usuarios-container">
    <div class="usuarios-form-panel">
        <UsuarioFormComponent UsuarioEditando="usuarioSeleccionado"
                              OnGuardar="HandleGuardarUsuario"
                              OnCancelar="HandleCancelarEdicion" />
    </div>

    <div class="usuarios-table-panel">
        <UsuarioTableComponent Usuarios="usuarios"
                               OnEditar="HandleEditarUsuario"
                               OnEliminar="HandleEliminarUsuario"
                               OnResetearContrasena="HandleResetearContrasena"
                               OnDesactivar="HandleDesactivarUsuario"
                               OnActivar="HandleActivarUsuario" />
    </div>
</section>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="error-box">
        @errorMensaje
    </div>
}

@if (!string.IsNullOrEmpty(exitoMensaje))
{
    <div class="success-box">
        @exitoMensaje
    </div>
}

@code {
    private List<Usuario> usuarios = new();
    private Usuario? usuarioSeleccionado;
    private string? errorMensaje;
    private string? exitoMensaje;

    /// <summary>
    /// Inicializa la vista y valida acceso administrativo.
    /// </summary>
    protected override void OnInitialized()
    {
        if (!authService.EstaAutenticado())
        {
            navigationManager.NavigateTo("/login");
            return;
        }

        if (authService.SesionActual?.EsAdmin != true)
        {
            navigationManager.NavigateTo("/");
            return;
        }

        CargarUsuarios();
    }

    /// <summary>
    /// Obtiene los usuarios desde la capa de servicios.
    /// </summary>
    private void CargarUsuarios()
    {
        usuarios = usuarioService.ObtenerTodos();
    }

    /// <summary>
    /// Guarda un usuario nuevo o actualiza uno existente.
    /// </summary>
    /// <param name="usuario">Usuario recibido desde el formulario.</param>
    private Task HandleGuardarUsuario(Usuario usuario)
    {
        try
        {
            if (usuario.Id == Guid.Empty)
            {
                usuarioService.CrearUsuario(usuario);
            }
            else
            {
                usuarioService.ActualizarUsuario(usuario);
            }

            CargarUsuarios();
            LimpiarSeleccion();
            MostrarExito("Usuario guardado exitosamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Selecciona un usuario para edición.
    /// </summary>
    /// <param name="usuario">Usuario seleccionado en la tabla.</param>
    private Task HandleEditarUsuario(Usuario usuario)
    {
        usuarioSeleccionado = ClonarUsuario(usuario);
        LimpiarMensajes();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Elimina un usuario del sistema.
    /// </summary>
    /// <param name="usuarioId">Identificador del usuario a eliminar.</param>
    private Task HandleEliminarUsuario(Guid usuarioId)
    {
        try
        {
            usuarioService.EliminarUsuario(usuarioId);
            CargarUsuarios();

            if (usuarioSeleccionado?.Id == usuarioId)
            {
                LimpiarSeleccion();
            }

            MostrarExito("Usuario eliminado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al eliminar usuario: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Cancela la edición actual.
    /// </summary>
    private Task HandleCancelarEdicion()
    {
        LimpiarSeleccion();
        LimpiarMensajes();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Restablece la contraseña de un usuario.
    /// </summary>
    /// <param name="usuarioId">Identificador del usuario.</param>
    private Task HandleResetearContrasena(Guid usuarioId)
    {
        try
        {
            usuarioService.ResetearContrasena(usuarioId);
            CargarUsuarios();

            MostrarExito("La contraseña fue restablecida correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al resetear contraseña: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Desactiva un usuario del sistema.
    /// </summary>
    /// <param name="usuarioId">Identificador del usuario.</param>
    private Task HandleDesactivarUsuario(Guid usuarioId)
    {
        try
        {
            usuarioService.DesactivarUsuario(usuarioId);
            CargarUsuarios();

            MostrarExito("El usuario fue desactivado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al desactivar usuario: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Activa un usuario del sistema.
    /// </summary>
    /// <param name="usuarioId">Identificador del usuario.</param>
    private Task HandleActivarUsuario(Guid usuarioId)
    {
        try
        {
            usuarioService.ActivarUsuario(usuarioId);
            CargarUsuarios();

            MostrarExito("El usuario fue activado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al activar usuario: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Crea una copia del usuario para edición.
    /// </summary>
    /// <param name="usuario">Usuario origen.</param>
    /// <returns>Usuario clonado.</returns>
    private static Usuario ClonarUsuario(Usuario usuario)
    {
        return new Usuario
        {
            Id = usuario.Id,
            Nombre = usuario.Nombre,
            Correo = usuario.Correo,
            Contrasena = usuario.Contrasena,
            Rol = usuario.Rol,
            Peso = usuario.Peso,
            Altura = usuario.Altura,
            Edad = usuario.Edad,
            NivelActividad = usuario.NivelActividad,
            Objetivo = usuario.Objetivo,
            TipoDieta = usuario.TipoDieta,
            Activo = usuario.Activo
        };
    }

    /// <summary>
    /// Limpia la selección actual del formulario.
    /// </summary>
    private void LimpiarSeleccion()
    {
        usuarioSeleccionado = null;
    }

    /// <summary>
    /// Limpia los mensajes de éxito y error.
    /// </summary>
    private void LimpiarMensajes()
    {
        errorMensaje = null;
        exitoMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de éxito.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarExito(string mensaje)
    {
        exitoMensaje = mensaje;
        errorMensaje = null;
    }

    /// <summary>
    /// Muestra un mensaje de error.
    /// </summary>
    /// <param name="mensaje">Mensaje a mostrar.</param>
    private void MostrarError(string mensaje)
    {
        errorMensaje = mensaje;
        exitoMensaje = null;
    }
}