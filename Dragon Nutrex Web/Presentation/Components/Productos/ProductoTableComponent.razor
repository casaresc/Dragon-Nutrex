@using Dragon_Nutrex_Web.Core.Models

<div class="card-panel">
    <div class="card-header">
        <h2>Listado de Productos</h2>
    </div>

    @if (Productos is null || Productos.Count == 0)
    {
        <p>No hay productos registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="app-table productos-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Proteína</th>
                        <th>Carbohidratos</th>
                        <th>Grasas</th>
                        <th>Porción</th>
                        <th>Calorías</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Productos)
                    {
                        <tr>
                            <td>@producto.Nombre</td>
                            <td>@producto.Categoria</td>
                            <td>@producto.Proteina</td>
                            <td>@producto.Carbohidratos</td>
                            <td>@producto.Grasas</td>
                            <td>@producto.PorcionGramos</td>
                            <td>@producto.Calorias</td>
                            <td>
                                <span class="status-badge @(producto.Activo ? "status-active" : "status-inactive")">
                                    @(producto.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons productos-actions">
                                    <button type="button" class="btn btn-warning" @onclick="() => HandleEditar(producto)">
                                        Editar
                                    </button>

                                    @if (producto.Activo)
                                    {
                                        <button type="button" class="btn btn-danger" @onclick="() => HandleDesactivar(producto.Id)">
                                            Desactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="() => HandleActivar(producto.Id)">
                                            Activar
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<Producto> Productos { get; set; } = new();

    [Parameter]
    public EventCallback<Producto> OnEditar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDesactivar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnActivar { get; set; }

    private async Task HandleEditar(Producto producto)
    {
        await OnEditar.InvokeAsync(producto);
    }

    private async Task HandleEliminar(Guid productoId)
    {
        await OnEliminar.InvokeAsync(productoId);
    }

    private async Task HandleDesactivar(Guid productoId)
    {
        await OnDesactivar.InvokeAsync(productoId);
    }

    private async Task HandleActivar(Guid productoId)
    {
        await OnActivar.InvokeAsync(productoId);
    }
}