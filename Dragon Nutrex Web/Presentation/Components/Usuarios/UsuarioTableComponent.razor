@using Dragon_Nutrex_Web.Core.Models

<div class="card-panel">
    <div class="card-header">
        <h2>Listado de Usuarios</h2>
    </div>

    @if (Usuarios is null || Usuarios.Count == 0)
    {
        <p>No hay usuarios registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="app-table usuarios-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Usuarios)
                    {
                        <tr>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Correo</td>
                            <td>@usuario.Rol</td>
                            <td>
                                <span class="status-badge @(usuario.Activo ? "status-active" : "status-inactive")">
                                    @(usuario.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons usuarios-actions">
                                    <button type="button" class="btn btn-warning" @onclick="() => HandleEditar(usuario)">
                                        Editar
                                    </button>

                                    <button type="button" class="btn btn-secondary" @onclick="() => HandleResetearContrasena(usuario.Id)">
                                        Reset Pass
                                    </button>

                                    @if (usuario.Rol != "Admin")
                                    {
                                        @if (usuario.Activo)
                                        {
                                            <button type="button" class="btn btn-danger" @onclick="() => HandleDesactivar(usuario.Id)">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-primary" @onclick="() => HandleActivar(usuario.Id)">
                                                Activar
                                            </button>
                                        }
                                    }

                                    <button type="button" class="btn btn-danger" @onclick="() => HandleEliminar(usuario.Id)">
                                        Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<Usuario> Usuarios { get; set; } = new();

    [Parameter]
    public EventCallback<Usuario> OnEditar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnResetearContrasena { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDesactivar { get; set; }

    [Parameter]
    public EventCallback<Guid> OnActivar { get; set; }

    private async Task HandleEditar(Usuario usuario)
    {
        await OnEditar.InvokeAsync(usuario);
    }

    private async Task HandleEliminar(Guid usuarioId)
    {
        await OnEliminar.InvokeAsync(usuarioId);
    }

    private async Task HandleResetearContrasena(Guid usuarioId)
    {
        await OnResetearContrasena.InvokeAsync(usuarioId);
    }

    private async Task HandleDesactivar(Guid usuarioId)
    {
        await OnDesactivar.InvokeAsync(usuarioId);
    }

    private async Task HandleActivar(Guid usuarioId)
    {
        await OnActivar.InvokeAsync(usuarioId);
    }
}