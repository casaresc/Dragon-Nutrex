@using Dragon_Nutrex_Web.Core.Models

<EditForm Model="menuModel" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card-panel">
        <div class="card-header">
            <h2>Crear Menú</h2>
        </div>

        <div class="form-grid">
            @if (MostrarSelectorUsuario)
            {
                <div class="form-group">
                    <label for="cmbUsuario">Usuario</label>
                    <InputSelect id="cmbUsuario"
                                 class="form-control"
                                 @bind-Value="menuModel.UsuarioId"
                                 @bind-Value:after="HandleCambioMenuBase">
                        <option value="@Guid.Empty">Seleccione un usuario</option>
                        @foreach (var usuario in Usuarios)
                        {
                            <option value="@usuario.Id">@usuario.Nombre</option>
                        }
                    </InputSelect>
                </div>
            }
            else
            {
                <input type="hidden" value="@menuModel.UsuarioId" />
            }

            <div class="form-group">
                <label for="txtNombre">Nombre del menú</label>
                <InputText id="txtNombre" class="form-control" @bind-Value="menuModel.Nombre" />
            </div>

            <div class="form-group">
                <label for="txtFecha">Fecha</label>
                <InputDate id="txtFecha" class="form-control" @bind-Value="menuModel.Fecha" @bind-Value:after="HandleCambioMenuBase" />
            </div>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Guardar Menú</button>
            <button type="button" class="btn btn-secondary" @onclick="HandleCancelar">Cancelar</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public MenuDiario? MenuEditando { get; set; }

    [Parameter]
    public List<Usuario> Usuarios { get; set; } = new();

    [Parameter]
    public EventCallback<MenuDiario> OnGuardar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    [Parameter]
    public EventCallback<MenuDiario> OnCambioMenuBase { get; set; }
    [Parameter]
    public bool MostrarSelectorUsuario { get; set; } = true;

    [Parameter]
    public Guid? UsuarioFijoId { get; set; }

    private MenuDiario menuModel = CrearMenuVacio();

    /// <summary>
    /// Actualiza el modelo local con los datos recibidos.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (MenuEditando is null)
        {
            menuModel = CrearMenuVacio();
        }
        else
        {
            menuModel = new MenuDiario
            {
                Id = MenuEditando.Id,
                UsuarioId = MenuEditando.UsuarioId,
                Nombre = MenuEditando.Nombre,
                Fecha = MenuEditando.Fecha
            };
        }

        if (!MostrarSelectorUsuario && UsuarioFijoId.HasValue)
        {
            menuModel.UsuarioId = UsuarioFijoId.Value;
        }
    }

    /// <summary>
    /// Envía el menú al componente padre.
    /// </summary>
    private async Task HandleSubmit()
    {
        await OnGuardar.InvokeAsync(menuModel);
        menuModel = CrearMenuVacio();
    }

    /// <summary>
    /// Cancela la edición actual.
    /// </summary>
    private async Task HandleCancelar()
    {
        menuModel = CrearMenuVacio();
        await OnCancelar.InvokeAsync();
    }

    /// <summary>
    /// Crea una instancia vacía del menú.
    /// </summary>
    /// <returns>Menú inicializado.</returns>
    private static MenuDiario CrearMenuVacio() =>
        new()
        {
            Id = Guid.Empty,
            UsuarioId = Guid.Empty,
            Nombre = string.Empty,
            Fecha = DateTime.Today
        };

    /// <summary>
    /// Notifica cambios en usuario o fecha para consultar si el menú ya existe.
    /// </summary>
    private async Task HandleCambioMenuBase()
    {
        await OnCambioMenuBase.InvokeAsync(menuModel);
    }
}